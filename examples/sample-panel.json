      "flow": [ ["hero", "massing"], ["massing", "plan"], ["flow", "timeline", "시간"] ]
    },
    {
      "layout": { "preset": "bento" },
      "cells": [
        { "id": "t2", "slot": 0, "type": "title", "data": { "title": "OCCUPYING PROCESS", "meta": "SHEET 02 / 02" } },
        { "id": "steps", "slot": 1, "type": "series", "heading": "STEPS",
