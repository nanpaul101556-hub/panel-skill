            { "type": "plan", "data": { "size": [6, 6], "grid": { "step": 1 } }, "caption": { "title": "1. STRUCTURE" } },
            { "type": "plan", "data": { "size": [6, 6], "grid": { "step": 1 }, "blocks": [ { "x": 2.8, "y": 0.3, "w": 0.4, "h": 0.4, "style": "white" }, { "x": 2.8, "y": 2.8, "w": 0.4, "h": 0.4, "style": "white" }, { "x": 2.8, "y": 5.3, "w": 0.4, "h": 0.4, "style": "white" } ] }, "caption": { "title": "2. CORES" } },
            { "type": "plan", "data": { "size": [6, 6], "grid": { "step": 1 }, "blocks": [ { "x": 0.2, "y": 0.2, "w": 1.8, "h": 1.8, "style": "fill" }, { "x": 4, "y": 4, "w": 1.8, "h": 1.8, "style": "fill" } ] }, "caption": { "title": "3. UNITS" } },
            { "type": "iso", "data": { "site": [6, 6], "boxes": [ { "at": [0, 0, 0], "size": [2, 2, 1], "style": "accent2" } ] }, "caption": { "title": "4. GROUND" } },
            { "type": "iso", "data": { "site": [6, 6], "boxes": [ { "at": [0, 0, 0], "size": [2, 2, 1], "style": "accent2" }, { "at": [2.5, 2.5, 0], "size": [1, 1, 4], "style": "dark" } ] }, "caption": { "title": "5. CORE" } },
            { "type": "iso", "data": { "site": [6, 6], "boxes": [ { "at": [0, 0, 0], "size": [2, 2, 1], "style": "accent2" }, { "at": [2.5, 2.5, 0], "size": [1, 1, 4], "style": "dark" }, { "at": [3.5, 0, 1], "size": [2.5, 2, 2], "style": "accent" } ] }, "caption": { "title": "6. INFILL" } }
          ] } },
        { "id": "txt", "slot": 2, "type": "text", "data": { "heading": "Concept", "body": ["건물은 한 번에 완성되지 않는다. 구조와 코어만 먼저 짓고, 나머지는 쓰는 사람들이 시간을 두고 채운다.", "패널은 이 점유 순서를 왼쪽 위에서 오른쪽 아래로 읽히게 배치했다."] } },
        { "id": "img", "slot": 3, "type": "image", "data": { "label": "RENDER" } },
        { "id": "leg", "slot": 4, "type": "legend", "heading": "LEGEND", "data": { "cols": 2, "items": [ { "label": "고정 구조", "style": "dark" }, { "label": "상업", "style": "accent2" }, { "label": "비공식 점유", "style": "accent" }, { "label": "방문객 동선", "style": "accent-line", "kind": "line" } ] } },
        { "id": "p2", "slot": 5, "type": "plan", "data": { "size": [10, 10], "grid": { "step": 1 }, "circles": [ { "x": 2, "y": 2, "r": 1, "dot": true }, { "x": 8, "y": 8, "r": 1, "dot": true } ] }, "caption": { "title": "ECOLOGY", "text": "빗물 정원과 태양광" } },
        { "id": "s2", "slot": 6, "type": "section", "heading": "LONG SECTION", "data": { "width": 60, "levels": [0, 4, 8], "blocks": [ { "x": 2, "z": 0, "w": 20, "h": 8, "style": "white" }, { "x": 24, "z": 0, "w": 30, "h": 4, "style": "accent2" } ] } },
        { "id": "f2", "slot": 7, "type": "flow", "heading": "LOOP", "data": { "direction": "column", "nodes": [ { "label": "수거" }, { "label": "정화", "style": "accent" }, { "label": "검사" }, { "label": "공개" } ] } }
      ],
      "flow": [ ["steps", "txt"], ["s2", "f2"] ]
