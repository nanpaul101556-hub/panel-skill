        { "id": "flow", "slot": 5, "type": "flow", "heading": "PROCESS",
          "data": { "nodes": [ { "label": "진단", "sub": "현황 조사" }, { "label": "전환", "sub": "임시 용도", "style": "accent" }, { "label": "정착", "sub": "새 용도" } ] } },
        { "id": "timeline", "slot": 6, "type": "timeline", "heading": "PHASING",
          "data": { "start": 2026, "end": 2036, "step": 2, "phases": [ { "label": "A 기존", "from": 2026, "to": 2028 }, { "label": "C 사이", "from": 2027, "to": 2031 }, { "label": "B 전환", "from": 2030, "to": 2036 } ], "marks": [ { "at": 2031, "label": "개장" } ] } },
        { "id": "bars", "slot": 7, "type": "bars", "heading": "AREA",
          "data": { "unit": "㎡", "items": [ { "label": "작업장", "value": 820 }, { "label": "식당", "value": 540 }, { "label": "연구동", "value": 410 }, { "label": "공용", "value": 330 } ] } }
